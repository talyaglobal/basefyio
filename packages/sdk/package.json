{
  "name": "basefyio-js",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.3.0",
  "description": "basefyio JavaScript/TypeScript SDK — tables, SQL, functions, auth, storage, collections, the Data Engine and realtime",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talyaglobal/basefyio.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://basefyio.com/docs/sdk",
  "bugs": {
    "url": "https://github.com/talyaglobal/basefyio/issues"
  },
  "keywords": [
    "basefyio",
    "baas",
    "database",
    "storage",
    "auth",
    "sdk",
    "hosted-postgres",
    "backend-as-a-service"
  ],
  "license": "MIT"
}
