# ─────────────────────────────────────────────────────────────────────────────
# basefyio — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# Values shown are safe local-dev defaults; change ALL secrets for production.
# The compose files pass an explicit list of variables into each container, so a
# variable set only here may never reach the API. docs/reference/configuration.md
# says which ones each compose file passes and how to pass the others.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core URLs ───────────────────────────────────────────────────────────────
# Public base domain used to derive service hostnames in production.
DOMAIN=example.com
# Where the admin dashboard is served.
APP_URL=http://localhost:3000
# Public base URL of the platform API (used in emails, OAuth callbacks, SDK).
PUBLIC_API_URL=http://localhost:4000

# ── PostgreSQL (shared control-plane database) ──────────────────────────────
POSTGRES_USER=basefyio
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=basefyio
# Full connection string used by Prisma (must match the values above).
DATABASE_URL=postgresql://basefyio:change-me-strong-password@postgres:5432/basefyio

# ── Keycloak (identity provider) ────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-password
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
# OAuth client id of the control-plane app inside the master realm.
PLATFORM_KEYCLOAK_CLIENT_ID=basefyio-platform

# ── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=basefyio
MINIO_ROOT_PASSWORD=change-me-strong-password

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Durable state (job queues, the scheduled-job lease, usage counters) on a
# second instance configured `noeviction`. Leave unset to keep everything on
# REDIS_URL; the compose files point it at the `redis-queue` service.
# REDIS_QUEUE_URL=redis://redis-queue:6379

# ── Request handling ─────────────────────────────────────────────────────────
# Proxies between the client and the API: Traefik alone is 1, a load balancer
# in front of it makes 2. Drives Express's `trust proxy`, which decides what
# `req.ip` (rate limits, sign-in audit) means.
TRUSTED_PROXY_HOPS=1
# `off` stops queueing an embedding job for every executed SQL statement.
SQL_QUERY_EMBEDDING=on
# On boot, an import/export job still "active" after this long with no progress
# is failed as an orphan of a dead process; younger ones may be running elsewhere.
IMPORT_STALE_AFTER_MS=1800000

# ── Release stage ─────────────────────────────────────────────────────────────
# "beta" puts a small badge next to every mark (dashboard, website, e-mails,
# invoices, social images); "ga" removes all of them in one deploy. The two
# Next apps inline it at build time, so set it here before building.
RELEASE_STAGE=beta

# ── Organization role permissions ────────────────────────────────────────────
# How far the per-role permission flags (dashboard: Organization → Roles) reach
# for the actions that used to ignore them: creating, deleting, restoring and
# moving projects; viewing and managing billing.
#   off     — the old rules only (owners and creators)
#   log     — flags grant what they promise; a denial is logged, not applied
#   enforce — flags grant and deny
ORG_PERMISSIONS_ENFORCED=log

# ── Platform status (availability measurement) ───────────────────────────────
# "true" runs the internal prober (leader only, every 30 s) and the 5-minute
# roll-ups; the public status data and the console page read what is there.
PLATFORM_STATUS_ENABLED=false
# Shared secret an external monitor sends as "Authorization: Bearer <token>" to
# POST /api/platform-status/samples. Unset = the endpoint answers 401.
PLATFORM_STATUS_PROBE_TOKEN=
# The public domain the probes target (api.<domain>, app.<domain>, ...); defaults to DOMAIN.
PLATFORM_DOMAIN=

# ── Capacity (how much the platform carries and how much more fits) ──────────
# "true" samples host, containers, Postgres, pooler, Redis and tenancy every
# 60 s on the scheduler leader and recomputes the capacity model every 5 min.
CAPACITY_SAMPLER_ENABLED=false
# Bearer token a load-test runner presents to POST /api/admin/capacity/benchmarks/results.
CAPACITY_BENCHMARK_TOKEN=

# ── Docker provisioning (dedicated per-project infra) ───────────────────────
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_NETWORK=basefyio_default
# Reverse-DNS prefix for metadata labels on managed Docker resources.
DOCKER_LABEL_PREFIX=com.basefyio

# ── PgBouncer (connection pooling) ──────────────────────────────────────────
PGBOUNCER_ADMIN_PASSWORD=change-me-strong-password
# Pooler globals written into pgbouncer.ini (defaults = the values used so far).
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=5
# Per-database cap (pool_size + max_db_connections) applied when neither the
# project nor its plan sets one. Leave empty for no per-database cap.
PGBOUNCER_DEFAULT_MAX_DB_CONNECTIONS=
# Highest value a project or plan may set.
PGBOUNCER_MAX_DB_CONNECTIONS_CEILING=100
# Also cap client connections per database (10x the server cap). Needs PgBouncer
# 1.24+; the API checks the pooler's version before writing the key.
PGBOUNCER_DB_CLIENT_LIMITS=false

# ── Project database provisioning ─────────────────────────────────────────────
# Install the default extension set (pg_trgm, pgcrypto, unaccent, btree_gist,
# uuid-ossp, vector; pg_stat_statements only where the server preloads it) into
# new project databases. Imports keep their own layout. false = owner role only.
PROVISION_DEFAULT_EXTENSIONS=true
# Create the SELECT-only companion role <dbUser>_readonly for new projects.
# Existing projects create it from Connection → Read-only access.
PROVISION_READONLY_ROLE=true

# ── Email (Resend) — optional ───────────────────────────────────────────────
RESEND_API_KEY=
# Quoted: an unquoted < or > breaks `source .env` from this line on.
RESEND_FROM_EMAIL="basefyio <noreply@example.com>"
RESEND_REPLY_TO=support@example.com
# Comma-separated recipients for new-feedback notifications.
FEEDBACK_NOTIFY_EMAILS=support@example.com
BILLING_SUMMARY_RECIPIENT=support@example.com

# ── Billing (Stripe) — optional ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── tsmart.ai billing feed — optional ───────────────────────────────────────
# sha256 (hex, 64 chars) of the bearer token tsmart.ai uses to read
# GET /api/integrations/tsmart/projects. tsmart keeps the token; only its hash
# goes here:  printf %s "$TOKEN" | sha256sum | cut -d" " -f1
# Empty = endpoint off (404). See docs/integrations/tsmart.md.
TSMART_INTEGRATION_TOKEN_SHA256=

# ── Accounting (QuickBooks Online) — optional ───────────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:4000/api/admin/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
# AES key used to encrypt stored QuickBooks tokens (set a strong random value).
QB_ENCRYPTION_KEY=

# ── Marketing agency (Admin > Marketing Agency) — optional ─────────────
# Claude writes the copy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# fal.ai renders the image and the video.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/text-to-video
# ElevenLabs voices the script. Voice id is the fallback when none is picked.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Pubbler distributes the finished post. API URL has no /public/v1 suffix.
PUBBLER_API_URL=
PUBBLER_API_KEY=
# Channel id posts default to — read it from Admin > Marketing Agency.
PUBBLER_DEFAULT_INTEGRATION_ID=

# Encrypts project database credentials at rest (AES-256-GCM). Required:
# without it the platform refuses to store a project credential rather than
# writing it in clear. 32 random bytes, base64 or 64 hex characters:
#   openssl rand -base64 32
DB_CRED_ENC_KEY=

# ── Deployment & scale ──────────────────────────────────────────────────────
# Number of platform-api containers (docker-compose.prod.yml). Keep 1 unless
# PGBOUNCER_ADMIN_PASSWORD is set and the host has ~2 GB RAM free per extra one.
API_REPLICAS=1
# Image tag for basefyio-api/ui/website. The deploy workflow writes the git sha
# it built here; leave empty to run :latest.
IMAGE_TAG=
# Prisma pool size per API replica (multiplies by API_REPLICAS against Postgres max_connections).
API_DB_CONNECTION_LIMIT=20
# One replica runs the scheduled jobs (Redis lease). false = every process runs them.
CRON_LEADER_ELECTION=true
# When Redis is unreachable for a full lease TTL: run (default) or pause the jobs.
CRON_LEADER_WHEN_REDIS_DOWN=run

# ── Reverse proxy with your own TLS certificate (docker compose --profile tls) ─
# PEM certificate (full chain) and private key; see docs/SELF_HOSTING_OFFLINE.md.
TLS_CERT_FILE=./docker/traefik/certs/tls.crt
TLS_KEY_FILE=./docker/traefik/certs/tls.key

# ── Object storage ──────────────────────────────────────────────────────────
# minio (default) keeps the MINIO_* settings above. s3 points the same client at any
# S3-compatible store (AWS S3, Cloudflare R2, Hetzner Object Storage, a remote MinIO).
STORAGE_DRIVER=minio
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com   # URL or host[:port]
# S3_REGION=eu-central-1                              # "auto" for Cloudflare R2
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=true
# S3_PATH_STYLE=true            # false = virtual-host addressing (recommended for AWS)
# S3_PUBLIC_ENDPOINT=           # host used in public and presigned URLs when it differs
# S3_BUCKET_POLICIES=true       # false on stores without PutBucketPolicy (Cloudflare R2)
# STORAGE_BUCKET_PREFIX=bf-     # change only on a fresh install
# STORAGE_MAX_UPLOAD_MB=500             # single-request ceiling; bodies are spooled to disk
# STORAGE_UPLOAD_TMP_DIR=               # default <os tmp>/basefyio-uploads
# STORAGE_MAX_CONCURRENT_UPLOADS=8
# STORAGE_RESUMABLE_CHUNK_MB=8          # clamped to 5–64
# STORAGE_MAX_RESUMABLE_MB=5120
# STORAGE_RESUMABLE_TTL_HOURS=24
# STORAGE_TRANSFORM_MAX_DIMENSION=4096  # image transforms (GET .../objects/render)
# STORAGE_TRANSFORM_MAX_SOURCE_MB=25
# STORAGE_TRANSFORM_MAX_PIXELS=50000000
# STORAGE_TRANSFORM_MAX_CONCURRENT=4
# STORAGE_TRANSFORM_CACHE_SECONDS=3600

# ── Realtime ────────────────────────────────────────────────────────────────
# Fan events out to every API instance through Redis pub/sub (redis) or keep delivery process-local (off).
REALTIME_FANOUT=redis
# Row-level security on the stream: jwt = filter subscribers that sent an access token (default);
# all = filter anon subscribers too; off = no filtering.
REALTIME_RLS_FILTER=jwt
REALTIME_RLS_META_TTL_MS=60000
REALTIME_PRESENCE_TTL_SEC=90
# Broadcast limits: payload bytes, per sender per minute, per project per minute (0 disables), require a signed-in user (1).
REALTIME_BROADCAST_MAX_BYTES=65536
REALTIME_BROADCAST_RATE_PER_MIN=600
REALTIME_BROADCAST_PROJECT_RATE_PER_MIN=6000
REALTIME_BROADCAST_REQUIRE_JWT=0

# ── Authentication for project end users ────────────────────────────────────
# Authenticator-app secrets are stored encrypted with DB_CRED_ENC_KEY (below).
# MFA_CHALLENGE_TTL_SECONDS=300
# MFA_MAX_ATTEMPTS=5
# Anonymous sign-in is off until a project enables it under Authentication → Settings.
# ANON_SIGNIN_PER_IP_HOURLY=30
# ANON_SIGNIN_PER_PROJECT_DAILY=5000

# ── AI / embeddings — optional ──────────────────────────────────────────────
# Provider for the platform vector store: openai (default) | ollama | cohere.
EMBEDDING_PROVIDER=openai
# Model at the provider. Empty = provider default (text-embedding-3-small / nomic-embed-text / embed-v4.0).
EMBEDDING_MODEL=
OLLAMA_BASE_URL=
COHERE_API_KEY=
# Failover provider used when the primary rejects the key, hits quota or is unreachable. Empty = off.
EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_MODEL=
# ISO country code of this server; shown to customers as the data/storage region. Empty = "not specified".
PLATFORM_REGION=
EMBEDDING_ALLOW_PRIVATE_BASE_URL=false
EMBEDDING_REEMBED_MAX_ROWS=200000

# ── Audit forwarding — optional ─────────────────────────────────────────────
# Off unless AUDIT_FORWARD_URL or AUDIT_SYSLOG_HOST is set (both may be set).
AUDIT_FORWARD_URL=
AUDIT_FORWARD_TOKEN=
AUDIT_FORWARD_FORMAT=ndjson
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=514
AUDIT_SYSLOG_PROTOCOL=udp

# ── Backups: off-site copies, restore verification, preview branches ────────
# See docs/BACKUP_OFFSITE_AND_VERIFICATION.md. Off-site copies stay off until BACKUP_S3_ENDPOINT is set.
# 32-byte key (openssl rand -base64 32). Keep a copy outside the server.
BACKUP_ENC_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
# false for AWS S3 (virtual-host addressing); true for Hetzner Object Storage, MinIO, R2
BACKUP_S3_PATH_STYLE=true
BACKUP_S3_PREFIX=basefyio/
BACKUP_OFFSITE_ALLOW_PLAINTEXT=false
BACKUP_ENCRYPT_LOCAL=false
BACKUP_TABLE_COUNTS=true
# Weekly restore drill (Sunday 05:00 UTC) into a throwaway database; false switches it off.
BACKUP_VERIFY_ENABLED=true
# Archives above this size are not drilled (smallest archives go first).
BACKUP_VERIFY_MAX_ARCHIVE_MB=256
# The drill is skipped when it would push the data volume above this usage.
BACKUP_VERIFY_MAX_DISK_PERCENT=85
BRANCH_LIMIT_PER_PROJECT=3
BRANCH_MAX_DB_MB=2048

# -- Idle projects -------------------------------------------
# A project nobody calls is put to sleep (status PAUSED): it keeps its
# database, files, users and plan slot, stops answering, and one click in the
# dashboard wakes it. The owner is warned by e-mail first.
# Off by default. PROJECT_SLEEP_SIGNAL_SINCE is required when it is on -- it is
# the moment request counting began, and every project's "last seen" is
# floored at it, so nothing can look idle until a full window has passed.
PROJECT_SLEEP_ENABLED=false
PROJECT_SLEEP_SIGNAL_SINCE=
PROJECT_SLEEP_IDLE_DAYS=14
PROJECT_SLEEP_WARN_DAYS=3
PROJECT_SLEEP_MAX_PER_RUN=25
