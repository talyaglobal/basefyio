# Components this release is built and tested with.
#
# scripts/install.sh writes the *_IMAGE pins below into the environment of a
# new installation and prints this list at the end of every install and
# upgrade. Any of them can be overridden by setting the same variable in the
# installation's env file. The compose files themselves keep their historical
# floating defaults, so an installation that never ran the installer is not
# moved by an update of this file.
#
# BASEFYIO_DB_CHANGES is written by scripts/release.mjs: whether
# apps/platform-api/prisma/schema.prisma changed since the previous release.
# The API applies the schema itself when it starts; changes are additive only.

BASEFYIO_DB_CHANGES=additive

# Keycloak — 24.0 is the default; 26.x is supported (BASEFYIO_KEYCLOAK=26).
KEYCLOAK_DEFAULT=24
KEYCLOAK_SUPPORTED="24.0.5 26.8.1"
KEYCLOAK_IMAGE_24=quay.io/keycloak/keycloak:24.0.5
KEYCLOAK_IMAGE_26=quay.io/keycloak/keycloak:26.8.1

# PostgreSQL 16 with pgvector 0.8 (self-host file; the production-shaped file
# builds docker/postgres, the same base plus PostGIS).
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg16-bookworm

# MinIO: the upstream image (minio/minio) can no longer be pulled anonymously.
# MINIO_IMAGE is the exact build basefyio runs in production, mirrored to the
# basefyio registry (needs a registry login); MINIO_IMAGE_PUBLIC is a public
# Chainguard build pinned by digest (MinIO RELEASE.2026-10-23T20-06-51Z) for
# new installations without that login.
MINIO_IMAGE=ghcr.io/fsipka/basefyio-minio:RELEASE.2025-09-07T16-13-09Z
MINIO_IMAGE_PUBLIC=chainguard/minio@sha256:a1d2b3516a41296510f7fb49184c18b88287fa8f35cf3ce5c047289053b94964

PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.25.1-p0
REDIS_IMAGE=redis:7.4.9-alpine
RABBITMQ_IMAGE=rabbitmq:4.4.0-management-alpine
MONGO_IMAGE=mongo:7.0.35
TRAEFIK_IMAGE=traefik:v3.1.7
CURL_IMAGE=curlimages/curl:8.23.0
COUCHBASE_IMAGE=couchbase/server:community-7.6.2
COUCHDB_IMAGE=apache/couchdb:3.5.3
