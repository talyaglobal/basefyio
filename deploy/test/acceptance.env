# The selections of the clean-machine acceptance test (selfhost-acceptance.yml):
# Keycloak 26, no document store, AI off, SMTP, PgBouncer on loopback, and a
# direct Postgres role. Mail goes to a local Mailpit (mailpit.yml) so the test
# can read what was sent.
BASEFYIO_BASE=selfhost
BASEFYIO_VERSION=current
BASEFYIO_IMAGES=build
BASEFYIO_KEYCLOAK=26
BASEFYIO_DOCSTORE=no
BASEFYIO_AI=off
BASEFYIO_MAIL=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
MAIL_FROM='Acceptance <noreply@example.test>'
KEYCLOAK_REALM_SMTP=true
BASEFYIO_PGBOUNCER_BIND=local
BASEFYIO_DB_ADMIN_ROLE=yes
POSTGRES_APP_ADMIN_USER=acceptance_admin
POSTGRES_APP_ADMIN_PASSWORD=Acceptance-pass-1
POSTGRES_DIRECT_BIND=127.0.0.1
POSTGRES_DIRECT_PORT=5432
BASEFYIO_OFFLINE=no
BASEFYIO_PIN_COMPONENTS=yes
BASEFYIO_CONFIRM_KEYCLOAK_26=yes
BASEFYIO_EXTRA_COMPOSE=deploy/test/mailpit.yml
